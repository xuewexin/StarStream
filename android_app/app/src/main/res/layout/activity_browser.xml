<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browser_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- 内置嗅探浏览器主界面 -->
    <LinearLayout
        android:id="@+id/browser_main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部地址栏与工具栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btn_exit_browser"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/btn_tabs_drawer"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/accent_cyan"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <EditText
                    android:id="@+id/et_url"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="输入网址或搜索..."
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="12.5sp" />

                <ImageButton
                    android:id="@+id/btn_bookmark"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="收藏"
                    android:padding="5dp"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/accent_amber" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_sniffed_sheet"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="嗅探"
                    android:src="@drawable/ic_download"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_sniffed_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_browser_menu"
                android:layout_width="32dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="菜单"
                android:padding="6dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/web_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="@color/accent_cyan"
            android:visibility="gone" />

        <!-- 中间内容区 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 下拉刷新包裹网页容器 -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/webview_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- 极简干净浏览器启动页 (无强制外部网页) -->
            <ScrollView
                android:id="@+id/start_page_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_main"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 极简品牌头 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="18dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:contentDescription="Logo"
                            android:src="@mipmap/ic_launcher" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="星流极简浏览器"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_engine_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Chrome 桌面 · 百度 · 下拉网页即可刷新"
                            android:textColor="@color/text_muted"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- 搜索盒 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_home_search"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input"
                                android:hint="搜索关键词或输入直达网址..."
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:paddingHorizontal="14dp"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/btn_home_search"
                                android:layout_width="68dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_btn_primary"
                                android:text="前往"
                                android:textColor="#FFFFFF"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="内置浏览器内核切换"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />

                            <LinearLayout
                                android:id="@+id/btn_refresh_identity"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_input"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="9dp">

                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:layout_marginEnd="4dp"
                                    android:contentDescription="身份刷新"
                                    android:src="@drawable/ic_fingerprint"
                                    app:tint="@color/accent_cyan" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="身份刷新"
                                    android:textColor="@color/accent_cyan"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/ua_chips_row"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="搜索引擎"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/engine_chips_row"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- 可折叠我的收藏网页 + 文件夹分类 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:id="@+id/header_bookmarks_toggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="收藏"
                                android:src="@drawable/ic_star_filled"
                                app:tint="@color/accent_amber" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="我的收藏书签"
                                android:textColor="@color/accent_amber"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/btn_new_bookmark_folder"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_input"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="9dp">

                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:layout_marginEnd="4dp"
                                    android:contentDescription="新建文件夹"
                                    android:src="@drawable/ic_folder_add"
                                    app:tint="@color/accent_amber" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="新建文件夹"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/iv_bookmarks_chevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="折叠展开"
                                android:src="@drawable/ic_expand_less"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/bookmarks_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical">

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:id="@+id/bookmark_folders_row"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />
                            </HorizontalScrollView>

                            <TextView
                                android:id="@+id/tv_bookmarks_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="该文件夹暂无收藏书签。浏览网页时点击地址栏星标即可分类收藏。"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/bookmarks_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 可折叠最近访问历史记录 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:id="@+id/header_history_toggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="历史"
                                android:src="@drawable/ic_history"
                                app:tint="@color/accent_cyan" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="最近访问记录"
                                android:textColor="@color/accent_cyan"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btn_all_history"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_input"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="管理全部"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <ImageView
                                android:id="@+id/iv_history_chevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="折叠展开"
                                android:src="@drawable/ic_expand_less"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/history_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_history_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="暂无浏览历史。访问网页后将自动记录，重启软件依然保留。"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/history_preview_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- 浏览器底部操作栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="后退"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="前进"
                android:padding="12dp"
                android:src="@drawable/ic_forward"
                app:tint="@color/text_muted" />

            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="主页"
                android:padding="11dp"
                android:src="@drawable/ic_home"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:id="@+id/btn_series_crawl"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1.5"
                android:background="@drawable/bg_pill_series"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="同系列"
                    android:src="@drawable/ic_series"
                    app:tint="#F3E8FF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="同系列"
                    android:textColor="#F3E8FF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_deep_parse"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1.5"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="深解析"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/accent_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="深解析"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="刷新"
                android:padding="11dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/accent_cyan" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左侧标签页抽屉 -->
    <LinearLayout
        android:id="@+id/drawer_tabs_panel"
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="标签页"
                android:src="@drawable/ic_tabs"
                app:tint="@color/accent_cyan" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="打开的标签页"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_new_tab"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="12dp"
                android:text="+ 新建"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/drawer_tabs_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 右侧收藏夹抽屉 -->
    <LinearLayout
        android:id="@+id/drawer_bookmarks_panel"
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/bg_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="收藏夹"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/accent_amber" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="浏览器收藏夹"
                android:textColor="@color/accent_amber"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/drawer_bookmarks_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
