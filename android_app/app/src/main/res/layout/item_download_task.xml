<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="视频标题"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_task_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="下载中"
            android:textColor="@color/accent_cyan"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_task"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressTint="@color/accent_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_task_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 B · --"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_task_preview"
            android:layout_width="70dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_series"
            android:padding="0dp"
            android:text="边下边看"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_task_action"
            android:layout_width="64dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_primary"
            android:padding="0dp"
            android:text="播放"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_task_del"
            android:layout_width="54dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_input"
            android:padding="0dp"
            android:text="删除"
            android:textColor="@color/accent_red"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
