<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/iv_sniff_type"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_input"
        android:contentDescription="类型"
        android:padding="5dp"
        android:src="@drawable/ic_video"
        app:tint="@color/accent_cyan" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_sniff_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sniff_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_sniff_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_sniff_preview"
        android:layout_width="54dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_input"
        android:padding="0dp"
        android:text="预览"
        android:textColor="@color/accent_cyan"
        android:textSize="11.5sp" />

    <Button
        android:id="@+id/btn_sniff_dl"
        android:layout_width="56dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_btn_primary"
        android:padding="0dp"
        android:text="下载"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp" />
</LinearLayout>
